{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-categorisation-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"cc-api.pomeloapps.com","custom_domain":true}],
  "vars": {"ALLOWED_ORIGIN":"https://cc.pomeloapps.com"},
  "observability": {"enabled": false}
}
